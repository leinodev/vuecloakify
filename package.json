{
  "name": "@leinodev/vuecloakify",
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.0",
  "type": "module",
  "license": "MIT",
  "description": "Build type-safe Keycloak login and email themes with Vue 3, Vite, FreeMarker, and optional MJML templates.",
  "author": {
    "name": "leinodev",
    "url": "https://github.com/leinodev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leinodev/vuecloakify.git"
  },
  "homepage": "https://github.com/leinodev/vuecloakify#readme",
  "bugs": {
    "url": "https://github.com/leinodev/vuecloakify/issues"
  },
  "keywords": [
    "keycloak",
    "keycloak-theme",
    "login-theme",
    "vue",
    "freemarker",
    "ftl",
    "prerender",
    "keycloakify"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vuecloakify": "./bin/vuecloakify.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js",
      "default": "./dist/build/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm examples:check && publint",
    "examples:check": "pnpm --filter './examples/*' typecheck && pnpm --filter './examples/*' build:theme",
    "lint": "eslint src scripts eslint.config.js",
    "prepare": "npm run build",
    "prepack": "npm run check",
    "typecheck": "vue-tsc --noEmit",
    "test": "pnpm build && node ./scripts/test.mjs"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "^5.0.0 || ^6.0.0",
    "mjml": "^4.15.0",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "mjml": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.10.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "pinia": "^3.0.4",
    "publint": "^0.3.21",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.3.5",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.7"
  }
}
