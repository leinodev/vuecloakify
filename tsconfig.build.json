{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": false,
    "target": "ES2022"
  },
  "include": ["src/index.ts", "src/runtime/**/*.ts", "src/build/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
